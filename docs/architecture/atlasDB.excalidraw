      "isDeleted": false,
      "boundElements": [],
      "updated": 1784649902295,
      "link": null,
      "locked": false,
      "text": "The internal nodes stores the range of data which is store by its child node\neach internal node should have two child nodes if there is one child node we can merge it with others \n\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The internal nodes stores the range of data which is store by its child node\neach internal node should have two child nodes if there is one child node we can merge it with others \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bDKYkv9x3_qGeBOP4Ks0B",
