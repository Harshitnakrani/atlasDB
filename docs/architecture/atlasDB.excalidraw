      "updated": 1784649902294,
      "link": null,
      "locked": false,
      "text": "Root node := like any tree structure there is root node of B+ tree which is starting point of graph\nIternal node := I will discuss about this later but understand it as a node which has its child nodes \nleaf node := A node which is vertically end of the tree ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Root node := like any tree structure there is root node of B+ tree which is starting point of graph\nIternal node := I will discuss about this later but understand it as a node which has its child nodes \nleaf node := A node which is vertically end of the tree ",
      "autoResize": true,
      "lineHeight": 1.25
    },
