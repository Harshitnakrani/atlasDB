    {
      "id": "ocf5Af1KD6GSa70DNou4N",
      "type": "text",
      "x": 29922.237001521433,
      "y": -10029.497990434576,
      "width": 2309.18310546875,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "JOQwbkLl1wDhzj65EvX2L",
        "PuTa78mXf-c_XPi8uzkDr"
      ],
      "frameId": null,
      "index": "c1Xb",
      "roundness": null,
      "seed": 1221473980,
      "version": 519,
      "versionNonce": 900200488,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784649902291,
      "link": null,
      "locked": false,
      "text": "The File I/O can append or re write the entier file there is no way we can add a new line in between of lines. \nSo in this case we have create a new file copy the rows which are going to be before the row in our case row 1 to 3 (line 1 to 3)\nthan append our new row which will be row 4 (line 4), than append the rest of the row (row 4 and 5) which will now be row 6 and 7 ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The File I/O can append or re write the entier file there is no way we can add a new line in between of lines. \nSo in this case we have create a new file copy the rows which are going to be before the row in our case row 1 to 3 (line 1 to 3)\nthan append our new row which will be row 4 (line 4), than append the rest of the row (row 4 and 5) which will now be row 6 and 7 ",
      "autoResize": true,
      "lineHeight": 1.25
    },
